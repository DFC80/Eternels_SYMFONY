{
    "name": "les-eternels/gaming-association",
    "type": "project",
    "license": "MIT",
    "description": "Les Eternels - Gaming Association Management Application",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.3|^4.0",
        "doctrine/orm": "^3.0",
        "easycorp/easyadmin-bundle": "^4.8|^5.0",
        "knplabs/knp-paginator-bundle": "^6.3",
        "symfony/asset": "^7.2",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/flex": "^2",
        "symfony/form": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/maker-bundle": "^1.60",
        "symfony/runtime": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/twig-bundle": "^7.2",
        "symfony/uid": "^7.2",
        "symfony/validator": "^7.2",
        "symfony/web-profiler-bundle": "^7.2",
        "symfony/yaml": "^7.2",
        "twig/twig": "^3.0",
        "vich/uploader-bundle": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "fakerphp/faker": "^1.24"
    }
}
