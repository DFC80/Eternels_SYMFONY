{% extends 'base.html.twig' %}

{% block title %}{{ activity.name }} — Les Éternels{% endblock %}

{% block body %}

{% set icons = {airsoft:'crosshairs', board_game:'chess', video_game:'gamepad', card_game:'layer-group', role_playing:'scroll'} %}

<div class="page-hero" style="padding:3rem 0 2.5rem;">
    <div class="container">
        <a href="{{ path('app_activities') }}"
           class="d-inline-flex align-items-center gap-2 mb-4 small fw-semibold"
           style="color:var(--text-muted);text-decoration:none;transition:color .2s;"
           onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">
            <i class="fas fa-arrow-left"></i> Toutes les activités
        </a>
        <div class="d-flex align-items-center gap-4">
            <div class="activity-icon" style="width:64px;height:64px;font-size:1.6rem;flex-shrink:0;">
                <i class="fas fa-{{ icons[activity.type] ?? 'star' }}"></i>
            </div>
            <div>
                <h1 style="font-family:'Rajdhani',sans-serif;font-size:clamp(1.8rem,5vw,3rem);font-weight:700;margin-bottom:.4rem;line-height:1.1;">
                    {{ activity.name }}
                </h1>
                <span class="badge badge-surface">{{ activity.type|replace({'_':' '})|capitalize }}</span>
            </div>
        </div>
    </div>
</div>

<div style="padding:3rem 0;">
    <div class="container">
        <div class="row g-4">

            {# Main content #}
            <div class="col-lg-8">

                {% if activity.description %}
                    <div class="card-dark p-4 mb-4">
                        <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);">
                            <i class="fas fa-info-circle me-2" style="color:var(--accent);"></i>Description
                        </h5>
                        <p style="color:var(--text-muted);line-height:1.75;margin:0;">{{ activity.description }}</p>
                    </div>
                {% endif %}

                {% if activity.games is not empty %}
                    <div class="card-dark p-4 mb-4">
                        <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1.25rem;color:var(--text-primary);">
                            <i class="fas fa-dice me-2" style="color:var(--accent);"></i>
                            Jeux disponibles
                            <span class="badge badge-accent ms-2">{{ activity.games|length }}</span>
                        </h5>
                        <div class="row g-3">
                            {% for game in activity.games %}
                                {% if game.isAvailable %}
                                    <div class="col-md-6">
                                        <div style="background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;padding:1rem;">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--text-primary);margin-bottom:.3rem;">
                                                    {{ game.name }}
                                                </h6>
                                                {% if game.difficulty %}
                                                    <span class="badge badge-surface flex-shrink-0">{{ game.difficulty }}</span>
                                                {% endif %}
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap">
                                                {% if game.minPlayers %}
                                                    <span class="small" style="color:var(--text-muted);">
                                                        <i class="fas fa-users me-1"></i>{{ game.minPlayers }}{% if game.maxPlayers %}-{{ game.maxPlayers }}{% endif %} joueurs
                                                    </span>
                                                {% endif %}
                                                {% if game.averageDuration %}
                                                    <span class="small" style="color:var(--text-muted);">
                                                        <i class="fas fa-clock me-1"></i>{{ game.averageDuration }} min
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if activity.photos is not empty %}
                    <div class="card-dark p-4">
                        <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1.25rem;color:var(--text-primary);">
                            <i class="fas fa-images me-2" style="color:var(--accent);"></i>Galerie photos
                        </h5>
                        <div class="row g-2">
                            {% for photo in activity.photos %}
                                {% if photo.isPublic %}
                                    <div class="col-4 col-md-3">
                                        <div style="aspect-ratio:1;background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                            <i class="fas fa-image fa-xl" style="color:var(--border);"></i>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

            </div>

            {# Sidebar #}
            <div class="col-lg-4">

                <div class="card-dark p-4 mb-4">
                    <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem;">
                        En chiffres
                    </h6>
                    <div class="row g-3">
                        {% for stat in [
                            {icon:'calendar-alt', value: activity.events|length,      label:'Événements'},
                            {icon:'dice',         value: activity.games|length,        label:'Jeux'},
                            {icon:'images',       value: activity.photos|length,       label:'Photos'},
                            {icon:'users',        value: activity.memberships|length,  label:'Membres'},
                        ] %}
                            <div class="col-6">
                                <div style="background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;padding:.85rem;text-align:center;">
                                    <div style="font-family:'Rajdhani',sans-serif;font-size:1.6rem;font-weight:700;color:var(--accent);line-height:1;">{{ stat.value }}</div>
                                    <div class="small" style="color:var(--text-muted);margin-top:.2rem;">{{ stat.label }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {% set upcoming = [] %}
                {% for event in activity.events %}
                    {% if event.startDate > date() %}
                        {% set upcoming = upcoming|merge([event]) %}
                    {% endif %}
                {% endfor %}

                {% if upcoming is not empty %}
                    <div class="card-dark p-4">
                        <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem;">
                            Prochains événements
                        </h6>
                        <div class="d-flex flex-column gap-2">
                            {% for event in upcoming|slice(0,5) %}
                                <a href="{{ path('app_event_show', {id: event.id}) }}" class="text-decoration-none">
                                    <div style="background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;padding:.75rem 1rem;transition:border-color .2s;"
                                         onmouseover="this.style.borderColor='rgba(230,55,87,.4)'" onmouseout="this.style.borderColor='var(--border)'">
                                        <div style="font-size:.9rem;font-weight:600;color:var(--text-primary);margin-bottom:.15rem;">{{ event.title }}</div>
                                        <div class="small" style="color:var(--text-muted);">
                                            <i class="fas fa-calendar me-1"></i>{{ event.startDate|date('d/m/Y') }}
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_events') }}" class="btn btn-outline-accent btn-sm w-100 mt-3">
                            Tous les événements
                        </a>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>

{% endblock %}
