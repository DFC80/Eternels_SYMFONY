{% extends 'base.html.twig' %}

{% block title %}Brocante Airsoft — Les Éternels{% endblock %}

{% block body %}

{# ── Page hero ─────────────────────────────────────────────────── #}
<div class="page-hero">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="section-label">Espace membres</span>
                <h1 style="font-family:'Rajdhani',sans-serif;font-size:2.2rem;font-weight:700;margin-bottom:.25rem;">
                    <i class="fas fa-tags me-2" style="color:var(--accent);"></i>Brocante Airsoft
                </h1>
                <p class="mb-0" style="color:var(--text-muted);">
                    {{ total_active }} annonce{{ total_active > 1 ? 's' : '' }} active{{ total_active > 1 ? 's' : '' }} — vente, échange, recherche entre membres
                </p>
            </div>
            <button class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#modalNewListing">
                <i class="fas fa-plus me-2"></i>Déposer une annonce
            </button>
        </div>
    </div>
</div>

<div style="padding:3rem 0 5rem;">
<div class="container">

{# ── Mes annonces ──────────────────────────────────────────────── #}
{% if my_listings is not empty %}
<section class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-3">
        <h2 style="font-family:'Rajdhani',sans-serif;font-size:1.4rem;font-weight:700;margin:0;">
            <i class="fas fa-user me-2 text-accent"></i>Mes annonces
        </h2>
        <span class="badge badge-surface">{{ my_listings|length }}</span>
    </div>

    <div class="row g-3">
        {% for listing in my_listings %}
            <div class="col-md-6 col-lg-4">
                {{ _self.listing_card(listing, app.user, true) }}
            </div>
        {% endfor %}
    </div>
</section>
<hr style="border-color:var(--border);margin-bottom:3rem;">
{% endif %}

{# ── Annonces des membres ──────────────────────────────────────── #}
<section>
    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 style="font-family:'Rajdhani',sans-serif;font-size:1.4rem;font-weight:700;margin:0;">
            <i class="fas fa-store me-2 text-accent"></i>Annonces des membres
        </h2>
        <span class="badge badge-surface">{{ other_listings|length }}</span>
    </div>

    {% if other_listings is empty and my_listings is empty %}
        <div class="card-dark text-center py-5">
            <i class="fas fa-tags fa-3x mb-3 d-block" style="color:var(--border);"></i>
            <p class="mb-3" style="color:var(--text-muted);">Aucune annonce pour le moment.</p>
            <button class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#modalNewListing">
                <i class="fas fa-plus me-2"></i>Soyez le premier à publier !
            </button>
        </div>
    {% elseif other_listings is empty %}
        <div class="card-dark text-center py-4" style="color:var(--text-muted);">
            <i class="fas fa-check-circle me-2" style="color:#4ade80;"></i>
            Aucune autre annonce active en ce moment.
        </div>
    {% else %}
        {# Filters #}
        <div class="d-flex flex-wrap gap-2 mb-4" id="filterBtns">
            <button class="btn btn-sm filter-btn active" data-filter="ALL"
                    style="background:var(--bg-surface);border:1px solid var(--border);color:var(--text-primary);border-radius:20px;padding:.35rem .9rem;">
                Tout
            </button>
            {% for label, val in {Vente:'VENTE', Échange:'ECHANGE', Recherche:'RECHERCHE'} %}
                <button class="btn btn-sm filter-btn" data-filter="{{ val }}"
                        style="background:var(--bg-surface);border:1px solid var(--border);color:var(--text-muted);border-radius:20px;padding:.35rem .9rem;">
                    {{ label }}
                </button>
            {% endfor %}
        </div>

        <div class="row g-3" id="listingsGrid">
            {% for listing in other_listings %}
                <div class="col-md-6 col-lg-4 listing-item" data-type="{{ listing.type }}">
                    {{ _self.listing_card(listing, app.user, false) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>

</div>
</div>

{# ── Modal : nouvelle annonce ──────────────────────────────────── #}
<div class="modal fade" id="modalNewListing" tabindex="-1" aria-labelledby="modalNewListingLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);">
            <div class="modal-header" style="border-color:var(--border);">
                <h5 class="modal-title" id="modalNewListingLabel" style="font-family:'Rajdhani',sans-serif;font-weight:700;">
                    <i class="fas fa-plus me-2 text-accent"></i>Déposer une annonce
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}
                    {{ include('market/_form_fields.html.twig') }}
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-accent btn-lg">
                            <i class="fas fa-paper-plane me-2"></i>Publier l'annonce
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% macro listing_card(listing, currentUser, isOwner) %}
{% set typeColors = {VENTE:'var(--accent)', ECHANGE:'#60a5fa', RECHERCHE:'#4ade80'} %}
{% set typeLabels = {VENTE:'Vente', ECHANGE:'Échange', RECHERCHE:'Recherche'} %}
{% set statusColors = {ACTIVE:'#4ade80', VENDU:'#fbbf24', CLOS:'var(--text-muted)'} %}

<div class="card-dark h-100 d-flex flex-column" style="{% if listing.status != 'ACTIVE' %}opacity:.65;{% endif %}">

    {# Photo or placeholder #}
    {% if listing.photos and listing.photos|length > 0 %}
        <img src="{{ listing.photos[0] }}" alt="{{ listing.title }}"
             style="width:100%;height:160px;object-fit:cover;border-radius:14px 14px 0 0;">
    {% else %}
        <div style="height:80px;background:var(--bg-surface);border-radius:14px 14px 0 0;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-image fa-2x" style="color:var(--border);"></i>
        </div>
    {% endif %}

    <div class="p-3 d-flex flex-column flex-grow-1">
        {# Badges #}
        <div class="d-flex gap-2 mb-2 flex-wrap">
            <span class="badge" style="background:{{ typeColors[listing.type] ?? 'var(--accent)' }};color:#fff;font-size:.7rem;">
                {{ typeLabels[listing.type] ?? listing.type }}
            </span>
            {% if listing.category %}
                <span class="badge badge-surface" style="font-size:.65rem;">{{ listing.category }}</span>
            {% endif %}
            {% if listing.status != 'ACTIVE' %}
                <span class="badge" style="background:{{ statusColors[listing.status] }};color:#000;font-size:.65rem;">
                    {{ listing.status }}
                </span>
            {% endif %}
        </div>

        <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;font-size:1rem;color:var(--text-primary);margin-bottom:.4rem;line-height:1.3;">
            {{ listing.title }}
        </h6>

        {% if listing.price %}
            <p class="mb-1" style="font-size:1.1rem;font-weight:700;color:var(--accent);">
                {{ listing.price|number_format(2, ',', ' ') }} €
            </p>
        {% endif %}

        <p class="small mb-2 flex-grow-1" style="color:var(--text-muted);line-height:1.5;">
            {{ listing.description|slice(0, 100) }}{% if listing.description|length > 100 %}…{% endif %}
        </p>

        <div class="small mb-3" style="color:var(--text-muted);">
            <i class="fas fa-user-circle me-1"></i>
            {% if isOwner %}
                <strong style="color:var(--text-primary);">Vous</strong>
            {% else %}
                {{ listing.seller.firstName }} {{ listing.seller.lastName|first }}.
            {% endif %}
            &nbsp;·&nbsp;
            <i class="fas fa-clock me-1"></i>{{ listing.createdAt|date('d/m/Y') }}
        </div>

        {# Actions #}
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_market_show', {id: listing.id}) }}" class="btn btn-outline-accent btn-sm flex-grow-1">
                <i class="fas fa-eye me-1"></i>Voir
            </a>
            {% if isOwner %}
                <a href="{{ path('app_market_edit', {id: listing.id}) }}" class="btn btn-sm flex-grow-1"
                   style="background:var(--bg-surface);border:1px solid var(--border);color:var(--text-muted);">
                    <i class="fas fa-pen me-1"></i>Modifier
                </a>
            {% endif %}
        </div>

        {# Owner status controls #}
        {% if isOwner %}
            <div class="d-flex gap-2 mt-2 flex-wrap">
                {% if listing.status == 'ACTIVE' %}
                    <form method="post" action="{{ path('app_market_status', {id: listing.id, status: 'VENDU'}) }}" class="flex-grow-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('market_status_' ~ listing.id) }}">
                        <button class="btn btn-sm w-100" style="background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.3);color:#fbbf24;">
                            <i class="fas fa-check me-1"></i>Vendu
                        </button>
                    </form>
                    <form method="post" action="{{ path('app_market_status', {id: listing.id, status: 'CLOS'}) }}" class="flex-grow-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('market_status_' ~ listing.id) }}">
                        <button class="btn btn-sm w-100" style="background:var(--bg-surface);border:1px solid var(--border);color:var(--text-muted);">
                            <i class="fas fa-ban me-1"></i>Clore
                        </button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('app_market_status', {id: listing.id, status: 'ACTIVE'}) }}" class="flex-grow-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('market_status_' ~ listing.id) }}">
                        <button class="btn btn-sm w-100" style="background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.3);color:#4ade80;">
                            <i class="fas fa-rotate-left me-1"></i>Réactiver
                        </button>
                    </form>
                {% endif %}
                <form method="post" action="{{ path('app_market_delete', {id: listing.id}) }}"
                      onsubmit="return confirm('Supprimer cette annonce ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_market_' ~ listing.id) }}">
                    <button class="btn btn-sm" style="background:rgba(239,68,68,.1);border:1px solid rgba(248,113,113,.3);color:#f87171;">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
</div>
{% endmacro %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const btns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.listing-item');
    btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            btns.forEach(function (b) {
                b.style.borderColor = 'var(--border)';
                b.style.color = 'var(--text-muted)';
                b.style.background = 'var(--bg-surface)';
            });
            this.style.borderColor = 'var(--accent)';
            this.style.color = '#fff';
            this.style.background = 'var(--accent)';
            var filter = this.dataset.filter;
            items.forEach(function (item) {
                item.style.display = (filter === 'ALL' || item.dataset.type === filter) ? '' : 'none';
            });
        });
    });
    // Activate default
    if (btns.length) {
        var first = btns[0];
        first.style.borderColor = 'var(--accent)';
        first.style.color = '#fff';
        first.style.background = 'var(--accent)';
    }
})();
</script>
{% endblock %}
