{% extends 'base.html.twig' %}

{% block title %}{{ listing.title }} — Brocante — Les Éternels{% endblock %}

{% block body %}

{% set typeColors = {VENTE:'var(--accent)', ECHANGE:'#60a5fa', RECHERCHE:'#4ade80'} %}
{% set typeLabels = {VENTE:'Vente', ECHANGE:'Échange', RECHERCHE:'Recherche'} %}
{% set catLabels = {REPLIQUE:'Réplique', PROTECTION:'Protection', TENUE:'Tenue / Équipement', ACCESSOIRE:'Accessoire', AUTRE:'Autre'} %}

<div class="page-hero">
    <div class="container">
        <a href="{{ path('app_market_index') }}" class="btn btn-sm mb-3"
           style="background:var(--bg-surface);border:1px solid var(--border);color:var(--text-muted);">
            <i class="fas fa-arrow-left me-1"></i>Retour à la brocante
        </a>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge" style="background:{{ typeColors[listing.type] ?? 'var(--accent)' }};color:#fff;">
                {{ typeLabels[listing.type] ?? listing.type }}
            </span>
            {% if listing.category %}
                <span class="badge badge-surface">{{ catLabels[listing.category] ?? listing.category }}</span>
            {% endif %}
            {% if listing.status != 'ACTIVE' %}
                <span class="badge badge-warning">{{ listing.status }}</span>
            {% endif %}
        </div>
        <h1 style="font-family:'Rajdhani',sans-serif;font-size:2rem;font-weight:700;margin-bottom:.4rem;">
            {{ listing.title }}
        </h1>
        <p class="mb-0" style="color:var(--text-muted);font-size:.875rem;">
            <i class="fas fa-user-circle me-1"></i>{{ listing.seller.firstName }} {{ listing.seller.lastName }}
            &nbsp;·&nbsp;
            <i class="fas fa-calendar me-1"></i>{{ listing.createdAt|date('d/m/Y à H:i') }}
        </p>
    </div>
</div>

<div style="padding:3rem 0 5rem;">
<div class="container">
<div class="row g-4">

    {# Photos #}
    <div class="col-lg-7">
        {% if listing.photos and listing.photos|length > 0 %}
            <div class="mb-3">
                <img src="{{ listing.photos[0] }}" id="mainPhoto" alt="{{ listing.title }}"
                     style="width:100%;max-height:440px;object-fit:contain;background:var(--bg-surface);border-radius:var(--radius-card);border:1px solid var(--border);">
            </div>
            {% if listing.photos|length > 1 %}
                <div class="d-flex gap-2 flex-wrap">
                    {% for photo in listing.photos %}
                        <img src="{{ photo }}" alt="photo"
                             onclick="document.getElementById('mainPhoto').src=this.src"
                             style="width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:.2s;">
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            <div class="card-dark d-flex align-items-center justify-content-center"
                 style="height:260px;color:var(--text-muted);">
                <div class="text-center">
                    <i class="fas fa-image fa-3x mb-2 d-block" style="color:var(--border);"></i>
                    Pas de photo
                </div>
            </div>
        {% endif %}
    </div>

    {# Details #}
    <div class="col-lg-5">
        <div class="card-dark p-4">
            {% if listing.price %}
                <div style="font-family:'Rajdhani',sans-serif;font-size:2rem;font-weight:700;color:var(--accent);margin-bottom:1rem;">
                    {{ listing.price|number_format(2, ',', ' ') }} €
                </div>
            {% elseif listing.type == 'VENTE' %}
                <p class="mb-3" style="color:var(--text-muted);">Prix à discuter</p>
            {% endif %}

            <h2 style="font-family:'Rajdhani',sans-serif;font-size:1.3rem;font-weight:700;margin-bottom:.75rem;">Description</h2>
            <p style="color:var(--text-muted);line-height:1.7;white-space:pre-line;">{{ listing.description }}</p>

            <hr style="border-color:var(--border);">

            <div class="d-flex flex-column gap-2 small" style="color:var(--text-muted);">
                <div><i class="fas fa-user me-2 text-accent"></i>
                    <strong style="color:var(--text-primary);">{{ listing.seller.firstName }} {{ listing.seller.lastName }}</strong>
                </div>
                <div><i class="fas fa-calendar me-2 text-accent"></i>Publié le {{ listing.createdAt|date('d/m/Y') }}</div>
                {% if listing.updatedAt %}
                    <div><i class="fas fa-pen me-2 text-accent"></i>Modifié le {{ listing.updatedAt|date('d/m/Y') }}</div>
                {% endif %}
            </div>

            {# Contact hint #}
            {% if listing.status == 'ACTIVE' and listing.seller != app.user %}
                <div class="mt-3 p-3" style="background:rgba(230,55,87,.07);border:1px solid rgba(230,55,87,.2);border-radius:10px;">
                    <p class="small mb-0" style="color:var(--text-muted);">
                        <i class="fas fa-info-circle me-1 text-accent"></i>
                        Contactez <strong style="color:var(--text-primary);">{{ listing.seller.firstName }}</strong>
                        directement lors d'une partie ou via l'espace membre.
                    </p>
                </div>
            {% endif %}

            {# Owner actions #}
            {% if listing.seller == app.user %}
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <a href="{{ path('app_market_edit', {id: listing.id}) }}" class="btn btn-outline-accent btn-sm flex-grow-1">
                        <i class="fas fa-pen me-1"></i>Modifier
                    </a>
                    <form method="post" action="{{ path('app_market_delete', {id: listing.id}) }}"
                          onsubmit="return confirm('Supprimer cette annonce ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_market_' ~ listing.id) }}">
                        <button class="btn btn-sm" style="background:rgba(239,68,68,.1);border:1px solid rgba(248,113,113,.3);color:#f87171;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>

</div>
</div>
</div>

{% endblock %}
