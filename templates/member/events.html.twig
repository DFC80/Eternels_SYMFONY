{% extends 'base.html.twig' %}

{% block title %}Evenements - Les Eternels{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold"><i class="fas fa-calendar-alt me-2 text-danger"></i>Prochains Evenements</h2>
            <p class="text-muted">Inscrivez-vous aux evenements a venir</p>
        </div>
    </div>

    {% if events is empty %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>Aucun evenement a venir pour le moment.
        </div>
    {% else %}
        <div class="row g-4">
            {% for event in events %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header py-3" style="background: linear-gradient(135deg, #1a1a2e, #16213e);">
                            <div class="text-center text-white">
                                <div class="fw-bold fs-3">{{ event.startDate|date('d') }}</div>
                                <div class="text-uppercase small" style="color: #e94560;">{{ event.startDate|date('M Y') }}</div>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">{{ event.title }}</h5>
                            {% if event.description %}
                                <p class="card-text text-muted small">{{ event.description|slice(0, 120) }}{% if event.description|length > 120 %}...{% endif %}</p>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                {% if event.activity %}
                                    <span class="badge bg-secondary">{{ event.activity.name }}</span>
                                {% endif %}
                                {% if event.price %}
                                    <span class="badge bg-success">{{ event.price }}€</span>
                                {% else %}
                                    <span class="badge bg-info">Gratuit</span>
                                {% endif %}
                                <span class="badge {{ event.status == 'open' ? 'bg-success' : 'bg-secondary' }}">
                                    {{ event.status == 'planned' ? 'Planifie' : (event.status == 'open' ? 'Ouvert' : 'En cours') }}
                                </span>
                            </div>
                            {% if event.location %}
                                <p class="small text-muted"><i class="fas fa-map-marker-alt me-1 text-danger"></i>{{ event.location }}</p>
                            {% endif %}
                            {% if event.maxParticipants %}
                                <p class="small text-muted">
                                    <i class="fas fa-users me-1"></i>{{ event.participantCount }}/{{ event.maxParticipants }} participants
                                </p>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <form method="post" action="{{ path('app_member_event_register', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('event_' ~ event.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm w-100"
                                    {{ not event.hasAvailableSpots ? 'disabled' : '' }}>
                                    <i class="fas fa-user-plus me-1"></i>
                                    {{ event.hasAvailableSpots ? "S'inscrire" : 'Complet' }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
