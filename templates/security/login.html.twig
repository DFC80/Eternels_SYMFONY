{% extends 'base.html.twig' %}

{% block title %}Connexion — Les Éternels{% endblock %}

{% block body %}
<div style="min-height:calc(100vh - 74px);display:flex;align-items:center;padding:3rem 0;
            background:radial-gradient(ellipse 60% 50% at 80% 50%, rgba(230,55,87,.08) 0%, transparent 70%);">
    <div class="container">
        <div class="row align-items-center g-5 justify-content-center">

            {# Branding panel #}
            <div class="col-lg-5 d-none d-lg-block">
                <p class="section-label mb-3">Bienvenue</p>
                <h1 style="font-family:'Rajdhani',sans-serif;font-size:3rem;font-weight:700;line-height:1.1;margin-bottom:1.25rem;">
                    Content de vous<br>revoir&nbsp;<span style="color:var(--accent);">!</span>
                </h1>
                <p style="color:var(--text-muted);line-height:1.7;margin-bottom:2rem;">
                    Connectez-vous pour accéder à votre espace membre, vous inscrire aux événements et gérer vos adhésions.
                </p>
                <div class="d-flex flex-column gap-3">
                    {% for item in [
                        {icon:'id-card',           text:'Gérez vos adhésions'},
                        {icon:'calendar-check',    text:'Inscrivez-vous aux événements'},
                        {icon:'beer-mug-empty',    text:'Suivez vos consommations'},
                    ] %}
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:36px;height:36px;border-radius:9px;background:rgba(230,55,87,.12);border:1px solid rgba(230,55,87,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fas fa-{{ item.icon }}" style="color:var(--accent);font-size:.85rem;"></i>
                            </div>
                            <span class="small" style="color:var(--text-muted);">{{ item.text }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Form panel #}
            <div class="col-lg-5 col-md-7 col-sm-10">
                <div class="card-dark p-4 p-md-5">
                    <h4 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:.35rem;">Connexion</h4>
                    <p class="small mb-4" style="color:var(--text-muted);">Entrez vos identifiants pour continuer</p>

                    {% if error %}
                        <div class="d-flex align-items-start gap-2 mb-4 p-3"
                             style="background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.2);border-radius:10px;">
                            <i class="fas fa-circle-xmark mt-1" style="color:#f87171;"></i>
                            <span class="small" style="color:#f87171;">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color:var(--text-muted);">Adresse email</label>
                            <div class="input-group input-group-dark">
                                <span class="input-group-text"><i class="fas fa-envelope fa-sm"></i></span>
                                <input type="email" name="_username" value="{{ last_username }}"
                                       class="form-control form-control-dark"
                                       placeholder="votre@email.fr" autocomplete="email" required autofocus>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold" style="color:var(--text-muted);">Mot de passe</label>
                            <div class="input-group input-group-dark">
                                <span class="input-group-text"><i class="fas fa-lock fa-sm"></i></span>
                                <input type="password" name="_password"
                                       class="form-control form-control-dark"
                                       placeholder="••••••••" autocomplete="current-password" required>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="_remember_me">
                                <label class="form-check-label small" for="rememberMe" style="color:var(--text-muted);">
                                    Se souvenir de moi
                                </label>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn-accent w-100 py-2 fw-semibold">
                            <i class="fas fa-arrow-right-to-bracket me-2"></i>Se connecter
                        </button>
                    </form>

                    <div class="divider-text my-4">ou</div>

                    <p class="text-center small mb-0" style="color:var(--text-muted);">
                        Pas encore membre ?
                        <a href="{{ path('app_register') }}" style="color:var(--accent);text-decoration:none;font-weight:600;">
                            Créer un compte
                        </a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
