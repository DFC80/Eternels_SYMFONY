{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} — Les Éternels{% endblock %}

{% block body %}

<div class="page-hero" style="padding:3rem 0 2.5rem;">
    <div class="container">
        <a href="{{ path('app_events') }}"
           class="d-inline-flex align-items-center gap-2 mb-4 small fw-semibold"
           style="color:var(--text-muted);text-decoration:none;transition:color .2s;"
           onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">
            <i class="fas fa-arrow-left"></i> Tous les événements
        </a>

        <div class="d-flex flex-wrap align-items-start gap-4">
            <div class="event-date-badge" style="width:72px;height:72px;flex-shrink:0;">
                <div class="day" style="font-size:1.6rem;">{{ event.startDate|date('d') }}</div>
                <div class="month">{{ event.startDate|date('M') }}</div>
            </div>
            <div>
                <h1 style="font-family:'Rajdhani',sans-serif;font-size:clamp(1.8rem,5vw,3rem);font-weight:700;margin-bottom:.5rem;line-height:1.1;">
                    {{ event.title }}
                </h1>
                <div class="d-flex gap-2 flex-wrap">
                    {% if event.activity %}
                        <span class="badge badge-surface">{{ event.activity.name }}</span>
                    {% endif %}
                    <span class="badge {{ event.status == 'open' ? 'badge-success' : (event.status == 'completed' ? 'badge-surface' : (event.status == 'cancelled' ? 'badge-danger' : 'badge-surface')) }}">
                        {{ {planned:'Planifié', open:'Inscriptions ouvertes', ongoing:'En cours', completed:'Terminé', cancelled:'Annulé'}[event.status] ?? event.status }}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div style="padding:3rem 0;">
    <div class="container">
        <div class="row g-4">

            {# Main content #}
            <div class="col-lg-8">

                {% if event.description %}
                    <div class="card-dark p-4 mb-4">
                        <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);">
                            <i class="fas fa-align-left me-2" style="color:var(--accent);"></i>Description
                        </h5>
                        <p style="color:var(--text-muted);line-height:1.75;margin:0;">{{ event.description }}</p>
                    </div>
                {% endif %}

                {% if event.meals is not empty %}
                    <div class="card-dark p-4 mb-4">
                        <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1.25rem;color:var(--text-primary);">
                            <i class="fas fa-utensils me-2" style="color:var(--accent);"></i>Repas disponibles
                        </h5>
                        <div class="row g-3">
                            {% for meal in event.meals %}
                                <div class="col-md-6">
                                    <div style="background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;padding:1rem;">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                            <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--text-primary);margin:0;">
                                                {{ meal.name }}
                                            </h6>
                                            {% if meal.isVegetarian %}
                                                <span class="badge badge-success flex-shrink-0">Végétarien</span>
                                            {% endif %}
                                        </div>
                                        {% if meal.description %}
                                            <p class="small mb-2" style="color:var(--text-muted);">{{ meal.description }}</p>
                                        {% endif %}
                                        <div style="font-family:'Rajdhani',sans-serif;font-size:1.2rem;font-weight:700;color:var(--accent);">
                                            {{ meal.price }}€
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

            </div>

            {# Sidebar #}
            <div class="col-lg-4">

                {# Info card #}
                <div class="card-dark p-4 mb-4">
                    <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);text-transform:uppercase;letter-spacing:.05em;font-size:.85rem;">
                        Informations
                    </h6>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex gap-3">
                            <i class="fas fa-calendar-day mt-1" style="color:var(--accent);width:16px;flex-shrink:0;"></i>
                            <div>
                                <div class="small" style="color:var(--text-muted);">Début</div>
                                <div style="color:var(--text-primary);font-weight:600;">{{ event.startDate|date('d/m/Y à H:i') }}</div>
                            </div>
                        </div>
                        {% if event.endDate %}
                            <div class="d-flex gap-3">
                                <i class="fas fa-calendar-check mt-1" style="color:var(--accent);width:16px;flex-shrink:0;"></i>
                                <div>
                                    <div class="small" style="color:var(--text-muted);">Fin</div>
                                    <div style="color:var(--text-primary);font-weight:600;">{{ event.endDate|date('d/m/Y à H:i') }}</div>
                                </div>
                            </div>
                        {% endif %}
                        {% if event.location %}
                            <div class="d-flex gap-3">
                                <i class="fas fa-location-dot mt-1" style="color:var(--accent);width:16px;flex-shrink:0;"></i>
                                <div>
                                    <div class="small" style="color:var(--text-muted);">Lieu</div>
                                    <div style="color:var(--text-primary);font-weight:600;">{{ event.location }}</div>
                                </div>
                            </div>
                        {% endif %}
                        <div class="d-flex gap-3">
                            <i class="fas fa-users mt-1" style="color:var(--accent);width:16px;flex-shrink:0;"></i>
                            <div>
                                <div class="small" style="color:var(--text-muted);">Participants</div>
                                <div style="color:var(--text-primary);font-weight:600;">
                                    {{ event.participantCount }}{% if event.maxParticipants %} / {{ event.maxParticipants }}{% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-3">
                            <i class="fas fa-tag mt-1" style="color:var(--accent);width:16px;flex-shrink:0;"></i>
                            <div>
                                <div class="small" style="color:var(--text-muted);">Tarif</div>
                                <div style="font-family:'Rajdhani',sans-serif;font-size:1.1rem;font-weight:700;color:{{ event.price and event.price > 0 ? 'var(--accent)' : '#34d399' }};">
                                    {% if event.price and event.price > 0 %}{{ event.price }}€{% else %}Gratuit{% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Registration #}
                {% if app.user %}
                    <div class="card-dark p-4">
                        <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;margin-bottom:1rem;color:var(--text-primary);">
                            Participer à l'événement
                        </h6>
                        {% if event.hasAvailableSpots %}
                            <form method="post" action="{{ path('app_member_event_register', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('event_' ~ event.id) }}">
                                <button type="submit" class="btn btn-accent w-100 py-2 fw-semibold">
                                    <i class="fas fa-user-plus me-2"></i>Je m'inscris
                                </button>
                            </form>
                        {% else %}
                            <div style="background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.2);border-radius:10px;padding:1rem;text-align:center;">
                                <i class="fas fa-ban mb-2 d-block" style="color:#fbbf24;"></i>
                                <span class="small" style="color:#fbbf24;">Événement complet</span>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="card-dark p-4 text-center">
                        <i class="fas fa-lock mb-2 d-block" style="color:var(--accent);font-size:1.5rem;"></i>
                        <p class="small mb-3" style="color:var(--text-muted);">Connectez-vous pour vous inscrire à cet événement</p>
                        <a href="{{ path('app_login') }}" class="btn btn-accent w-100 fw-semibold">
                            <i class="fas fa-arrow-right-to-bracket me-2"></i>Se connecter
                        </a>
                        <p class="small mt-2 mb-0" style="color:var(--text-muted);">
                            Pas de compte ?
                            <a href="{{ path('app_register') }}" style="color:var(--accent);text-decoration:none;">Créer un compte</a>
                        </p>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>

{% endblock %}
