{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} - Les Eternels{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="{{ path('app_events') }}" class="btn btn-outline-secondary mb-3">
                <i class="fas fa-arrow-left me-1"></i>Retour aux evenements
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-4" style="background: linear-gradient(135deg, #1a1a2e, #16213e);">
                    <div class="text-white">
                        <h2 class="mb-1">{{ event.title }}</h2>
                        <div class="d-flex gap-2 flex-wrap">
                            {% if event.activity %}
                                <span class="badge bg-secondary">{{ event.activity.name }}</span>
                            {% endif %}
                            <span class="badge {{ event.status == 'open' ? 'bg-success' : (event.status == 'planned' ? 'bg-secondary' : 'bg-info') }}">
                                {{ event.status == 'planned' ? 'Planifie' : (event.status == 'open' ? 'Inscriptions ouvertes' : event.status) }}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    {% if event.description %}
                        <h5>Description</h5>
                        <p class="text-muted">{{ event.description }}</p>
                        <hr>
                    {% endif %}

                    {% if event.meals is not empty %}
                        <h5><i class="fas fa-utensils me-2 text-danger"></i>Repas disponibles</h5>
                        <div class="row g-2 mb-3">
                            {% for meal in event.meals %}
                                <div class="col-md-6">
                                    <div class="card border">
                                        <div class="card-body p-3">
                                            <h6 class="mb-1">{{ meal.name }}
                                                {% if meal.isVegetarian %}<span class="badge bg-success ms-1">Vegetarien</span>{% endif %}
                                            </h6>
                                            {% if meal.description %}
                                                <p class="small text-muted mb-1">{{ meal.description }}</p>
                                            {% endif %}
                                            <strong class="text-success">{{ meal.price }}€</strong>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-info-circle me-2 text-danger"></i>Informations</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-calendar me-2 text-muted"></i>
                            <strong>Debut :</strong> {{ event.startDate|date('d/m/Y H:i') }}
                        </li>
                        {% if event.endDate %}
                            <li class="mb-2">
                                <i class="fas fa-calendar-check me-2 text-muted"></i>
                                <strong>Fin :</strong> {{ event.endDate|date('d/m/Y H:i') }}
                            </li>
                        {% endif %}
                        {% if event.location %}
                            <li class="mb-2">
                                <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                                <strong>Lieu :</strong> {{ event.location }}
                            </li>
                        {% endif %}
                        <li class="mb-2">
                            <i class="fas fa-users me-2 text-muted"></i>
                            <strong>Participants :</strong> {{ event.participantCount }}
                            {% if event.maxParticipants %}/ {{ event.maxParticipants }}{% endif %}
                        </li>
                        {% if event.price %}
                            <li class="mb-2">
                                <i class="fas fa-euro-sign me-2 text-muted"></i>
                                <strong>Prix :</strong> {{ event.price }}€
                            </li>
                        {% else %}
                            <li class="mb-2">
                                <i class="fas fa-gift me-2 text-muted"></i>
                                <strong>Prix :</strong> <span class="text-success">Gratuit</span>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>

            {% if app.user %}
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">S'inscrire</h5>
                        {% if event.hasAvailableSpots %}
                            <form method="post" action="{{ path('app_member_event_register', {id: event.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('event_' ~ event.id) }}">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="fas fa-user-plus me-2"></i>Je m'inscris
                                </button>
                            </form>
                        {% else %}
                            <div class="alert alert-warning mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>Evenement complet
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <p class="text-muted">Connectez-vous pour vous inscrire</p>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-danger w-100">
                            <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
