{% extends 'base.html.twig' %}

{% block title %}Evenements - Les Eternels{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold"><i class="fas fa-calendar-alt me-2 text-danger"></i>Evenements</h1>
        <p class="text-muted lead">Decouvrez nos prochains evenements et rencontres</p>
    </div>

    {% if events is empty %}
        <div class="alert alert-info text-center">
            <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>
            Aucun evenement a venir pour le moment. Revenez bientot !
        </div>
    {% else %}
        <div class="row g-4">
            {% for event in events %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100 card-hover">
                        <div class="card-header py-3" style="background: linear-gradient(135deg, #1a1a2e, #16213e);">
                            <div class="text-center text-white">
                                <div class="fw-bold fs-2">{{ event.startDate|date('d') }}</div>
                                <div class="text-uppercase" style="color: #e94560;">{{ event.startDate|date('M Y') }}</div>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">{{ event.title }}</h5>
                            {% if event.description %}
                                <p class="card-text text-muted small">{{ event.description|slice(0, 100) }}{% if event.description|length > 100 %}...{% endif %}</p>
                            {% endif %}
                            <div class="d-flex gap-1 flex-wrap mb-2">
                                {% if event.activity %}
                                    <span class="badge bg-secondary">{{ event.activity.name }}</span>
                                {% endif %}
                                {% if event.price %}
                                    <span class="badge bg-success">{{ event.price }}€</span>
                                {% else %}
                                    <span class="badge bg-info">Gratuit</span>
                                {% endif %}
                            </div>
                            {% if event.location %}
                                <p class="small text-muted mb-1"><i class="fas fa-map-marker-alt me-1 text-danger"></i>{{ event.location }}</p>
                            {% endif %}
                            {% if event.maxParticipants %}
                                <p class="small text-muted mb-0"><i class="fas fa-users me-1"></i>{{ event.participantCount }}/{{ event.maxParticipants }} participants</p>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn-outline-danger btn-sm w-100">
                                Voir les details
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
