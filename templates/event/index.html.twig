{% extends 'base.html.twig' %}

{% block title %}Événements — Les Éternels{% endblock %}

{% block body %}

<div class="page-hero">
    <div class="container text-center">
        <span class="section-label mb-3 d-block">Au programme</span>
        <h1 style="font-family:'Rajdhani',sans-serif;font-size:clamp(2rem,6vw,3.5rem);font-weight:700;margin-bottom:1rem;">
            Nos <span style="color:var(--accent);">Événements</span>
        </h1>
        <p style="color:var(--text-muted);font-size:1.05rem;max-width:480px;margin:0 auto;">
            Parties, tournois, soirées jeux — ne manquez aucune rencontre de l'association.
        </p>
    </div>
</div>

<div style="padding:4rem 0;">
    <div class="container">

        {% if events is empty %}
            <div class="card-dark text-center py-5">
                <i class="fas fa-calendar-times fa-3x mb-3 d-block" style="color:var(--accent);opacity:.5;"></i>
                <p style="color:var(--text-muted);margin:0;">Aucun événement à venir pour le moment. Revenez bientôt&nbsp;!</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in events %}
                    <div class="col-lg-4 col-md-6">
                        <div class="card-dark h-100 d-flex flex-column">

                            <div class="p-4 d-flex align-items-start gap-3"
                                 style="border-bottom:1px solid var(--border);">
                                <div class="event-date-badge flex-shrink-0">
                                    <div class="day">{{ event.startDate|date('d') }}</div>
                                    <div class="month">{{ event.startDate|date('M') }}</div>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--text-primary);margin-bottom:.35rem;font-size:1.05rem;line-height:1.25;">
                                        {{ event.title }}
                                    </h6>
                                    {% if event.location %}
                                        <p class="small mb-1" style="color:var(--text-muted);">
                                            <i class="fas fa-location-dot me-1" style="color:var(--accent);"></i>
                                            {{ event.location|slice(0,45) }}{% if event.location|length > 45 %}…{% endif %}
                                        </p>
                                    {% endif %}
                                    <p class="small mb-0" style="color:var(--text-muted);">
                                        <i class="fas fa-clock me-1"></i>{{ event.startDate|date('H:i') }}
                                    </p>
                                </div>
                            </div>

                            {% if event.description %}
                                <div class="px-4 pt-3 pb-0">
                                    <p class="small mb-0" style="color:var(--text-muted);line-height:1.6;">
                                        {{ event.description|slice(0,110) }}{% if event.description|length > 110 %}…{% endif %}
                                    </p>
                                </div>
                            {% endif %}

                            <div class="p-3 d-flex align-items-center justify-content-between mt-auto">
                                <div class="d-flex gap-1 flex-wrap">
                                    {% if event.activity %}
                                        <span class="badge badge-surface small">{{ event.activity.name }}</span>
                                    {% endif %}
                                    {% if event.price and event.price > 0 %}
                                        <span class="badge badge-success small">{{ event.price }}€</span>
                                    {% else %}
                                        <span class="badge badge-info small">Gratuit</span>
                                    {% endif %}
                                    {% if event.maxParticipants %}
                                        <span class="badge badge-surface small">
                                            <i class="fas fa-users me-1"></i>{{ event.participantCount }}/{{ event.maxParticipants }}
                                        </span>
                                    {% endif %}
                                </div>
                                <a href="{{ path('app_event_show', {id: event.id}) }}"
                                   class="btn btn-outline-accent btn-sm">Voir</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</div>

{% endblock %}
