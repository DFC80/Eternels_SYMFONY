{% extends 'base.html.twig' %}

{% block title %}Les Éternels — Association de Jeux{% endblock %}

{% block body %}

{# ── Hero ──────────────────────────────────────────────────────── #}
<section style="
    background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(230,55,87,.18) 0%, transparent 70%),
                linear-gradient(180deg, #0d0f1a 0%, #111326 100%);
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--border);
    position: relative; overflow: hidden;">

    {# decorative grid #}
    <div aria-hidden="true" style="
        position:absolute;inset:0;
        background-image: linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
        background-size:40px 40px; pointer-events:none;"></div>

    <div class="container text-center position-relative">
        <span class="section-label mb-3 d-block">— Association de jeux —</span>

        <h1 style="font-family:'Rajdhani',sans-serif;font-size:clamp(3rem,8vw,5.5rem);font-weight:700;line-height:1.05;margin-bottom:1.5rem;">
            Les <span style="color:var(--accent);text-shadow:0 0 40px rgba(230,55,87,.4);">Éternels</span>
        </h1>

        <p class="mb-5 mx-auto" style="max-width:540px;color:var(--text-muted);font-size:1.15rem;line-height:1.6;">
            Airsoft, jeux de société, jeux vidéo, jeux de rôle&hellip;
            Rejoignez une communauté de passionnés et vivez des moments inoubliables.
        </p>

        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="{{ path('app_activities') }}" class="btn btn-accent btn-lg px-4">
                <i class="fas fa-gamepad me-2"></i>Nos activités
            </a>
            <a href="{{ path('app_events') }}" class="btn btn-outline-accent btn-lg px-4">
                <i class="fas fa-calendar-days me-2"></i>Événements
            </a>
            {% if not app.user %}
                <a href="{{ path('app_register') }}" class="btn btn-lg px-4"
                   style="background:rgba(255,255,255,.07);border:1px solid var(--border);color:var(--text-primary);">
                    <i class="fas fa-user-plus me-2"></i>Nous rejoindre
                </a>
            {% endif %}
        </div>
    </div>
</section>

{# ── Stats strip ───────────────────────────────────────────────── #}
<section style="background:var(--bg-card);border-bottom:1px solid var(--border);padding:1.75rem 0;">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-4">
                <div style="font-family:'Rajdhani',sans-serif;font-size:2.5rem;font-weight:700;color:var(--accent);line-height:1;">
                    {{ activities|length }}
                </div>
                <div class="small" style="color:var(--text-muted);letter-spacing:.05em;text-transform:uppercase;font-size:.75rem;margin-top:.25rem;">Activités</div>
            </div>
            <div class="col-4">
                <div style="font-family:'Rajdhani',sans-serif;font-size:2.5rem;font-weight:700;color:var(--accent);line-height:1;">
                    {{ upcoming_events|length }}
                </div>
                <div class="small" style="color:var(--text-muted);letter-spacing:.05em;text-transform:uppercase;font-size:.75rem;margin-top:.25rem;">Événements à venir</div>
            </div>
            <div class="col-4">
                <div style="font-family:'Rajdhani',sans-serif;font-size:2.5rem;font-weight:700;color:var(--accent);line-height:1;">
                    2024
                </div>
                <div class="small" style="color:var(--text-muted);letter-spacing:.05em;text-transform:uppercase;font-size:.75rem;margin-top:.25rem;">Fondation</div>
            </div>
        </div>
    </div>
</section>

{# ── Activities ────────────────────────────────────────────────── #}
<section style="padding:5rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Ce que nous faisons</span>
            <h2 class="section-title">Nos Activités</h2>
            <div class="section-divider"></div>
        </div>

        {% set icons = {airsoft:'crosshairs', board_game:'chess', video_game:'gamepad', card_game:'layer-group', role_playing:'scroll'} %}

        <div class="row g-4">
            {% for activity in activities %}
                <div class="col-lg-4 col-md-6">
                    <a href="{{ path('app_activity_show', {id: activity.id}) }}" class="text-decoration-none">
                        <div class="card-dark h-100 p-4 text-center d-flex flex-column align-items-center">
                            <div class="activity-icon">
                                <i class="fas fa-{{ icons[activity.type] ?? 'star' }}"></i>
                            </div>
                            <h5 style="font-family:'Rajdhani',sans-serif;font-weight:700;font-size:1.2rem;color:var(--text-primary);">
                                {{ activity.name }}
                            </h5>
                            {% if activity.description %}
                                <p class="small mb-3" style="color:var(--text-muted);line-height:1.55;">
                                    {{ activity.description|slice(0,110) }}{% if activity.description|length > 110 %}…{% endif %}
                                </p>
                            {% endif %}
                            <div class="d-flex gap-2 flex-wrap justify-content-center mt-auto">
                                <span class="badge badge-surface">{{ activity.games|length }} jeux</span>
                                <span class="badge badge-surface">{{ activity.events|length }} événements</span>
                            </div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="card-dark text-center py-5" style="color:var(--text-muted);">
                        <i class="fas fa-gamepad fa-2x mb-3 d-block" style="color:var(--accent);"></i>
                        Aucune activité disponible pour le moment.
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── Upcoming events ───────────────────────────────────────────── #}
{% if upcoming_events is not empty %}
<section style="padding:5rem 0;background:var(--bg-card);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Ne les ratez pas</span>
            <h2 class="section-title">Prochains Événements</h2>
            <div class="section-divider"></div>
        </div>

        <div class="row g-4">
            {% for event in upcoming_events %}
                <div class="col-lg-4 col-md-6">
                    <div class="card-dark h-100 d-flex flex-column">
                        <div class="p-4 border-bottom" style="border-color:var(--border)!important;">
                            <div class="d-flex align-items-start gap-3">
                                <div class="event-date-badge">
                                    <div class="day">{{ event.startDate|date('d') }}</div>
                                    <div class="month">{{ event.startDate|date('M') }}</div>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--text-primary);margin-bottom:.35rem;font-size:1rem;">
                                        {{ event.title }}
                                    </h6>
                                    {% if event.location %}
                                        <p class="small mb-0" style="color:var(--text-muted);">
                                            <i class="fas fa-location-dot me-1 text-accent"></i>{{ event.location|slice(0,50) }}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="p-3 d-flex align-items-center justify-content-between mt-auto">
                            <div class="d-flex gap-1 flex-wrap">
                                {% if event.activity %}
                                    <span class="badge badge-surface small">{{ event.activity.name }}</span>
                                {% endif %}
                                {% if event.price and event.price > 0 %}
                                    <span class="badge badge-success small">{{ event.price }}€</span>
                                {% else %}
                                    <span class="badge badge-info small">Gratuit</span>
                                {% endif %}
                            </div>
                            <a href="{{ path('app_event_show', {id: event.id}) }}"
                               class="btn btn-outline-accent btn-sm">Voir</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mt-5">
            <a href="{{ path('app_events') }}" class="btn btn-accent px-4">
                <i class="fas fa-calendar-days me-2"></i>Tous les événements
            </a>
        </div>
    </div>
</section>
{% endif %}

{# ── Features ──────────────────────────────────────────────────── #}
<section style="padding:5rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Pourquoi nous rejoindre</span>
            <h2 class="section-title">Des avantages membres</h2>
            <div class="section-divider"></div>
        </div>

        <div class="row g-4">
            {% set features = [
                {icon:'shield-halved', title:'Accès aux équipements', text:"Profitez de notre matériel airsoft, jeux de société et consoles disponibles pour les membres."},
                {icon:'calendar-check', title:'Événements exclusifs', text:"Participez à des parties privées, tournois et soirées organisés tout au long de l'année."},
                {icon:'users-gear', title:'Communauté passionnée', text:"Rejoignez une équipe soudée et partagez votre passion dans une ambiance conviviale."},
            ] %}
            {% for f in features %}
                <div class="col-md-4">
                    <div class="card-dark h-100 p-4">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(230,55,87,.1);border:1px solid rgba(230,55,87,.2);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                            <i class="fas fa-{{ f.icon }}" style="color:var(--accent);font-size:1.2rem;"></i>
                        </div>
                        <h6 style="font-family:'Rajdhani',sans-serif;font-weight:700;font-size:1.05rem;color:var(--text-primary);margin-bottom:.5rem;">
                            {{ f.title }}
                        </h6>
                        <p class="small mb-0" style="color:var(--text-muted);line-height:1.6;">{{ f.text }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── CTA ───────────────────────────────────────────────────────── #}
{% if not app.user %}
<section style="padding:5rem 0;background:var(--bg-card);border-top:1px solid var(--border);">
    <div class="container text-center">
        <h2 style="font-family:'Rajdhani',sans-serif;font-size:2.4rem;font-weight:700;margin-bottom:1rem;">
            Prêt à rejoindre l'aventure&nbsp;?
        </h2>
        <p class="mb-4" style="color:var(--text-muted);font-size:1.05rem;">
            Créez votre compte gratuitement et accédez à l'espace membre.
        </p>
        <a href="{{ path('app_register') }}" class="btn btn-accent btn-lg px-5">
            <i class="fas fa-user-plus me-2"></i>Créer mon compte
        </a>
    </div>
</section>
{% endif %}

{% endblock %}
