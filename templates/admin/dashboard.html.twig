{% extends '@EasyAdmin/page/content.html.twig' %}

{% block main %}
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-users fa-3x text-primary mb-3"></i>
            <h3 class="fw-bold">{{ stats.total_members }}</h3>
            <p class="text-muted mb-0">Membres total</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-id-card fa-3x text-success mb-3"></i>
            <h3 class="fw-bold">{{ stats.active_memberships }}</h3>
            <p class="text-muted mb-0">Adhesions actives</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-calendar-alt fa-3x text-warning mb-3"></i>
            <h3 class="fw-bold">{{ stats.upcoming_events }}</h3>
            <p class="text-muted mb-0">Evenements a venir</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h5><i class="fas fa-tachometer-alt me-2"></i>Tableau de bord - Les Eternels</h5>
        <p class="text-muted">Bienvenue dans l'interface d'administration. Utilisez le menu de gauche pour naviguer.</p>
        <div class="row g-3 mt-2">
            <div class="col-auto">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-users me-1"></i>Gerer les membres
                </a>
            </div>
            <div class="col-auto">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\EventCrudController') }}" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-calendar me-1"></i>Gerer les evenements
                </a>
            </div>
            <div class="col-auto">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\ActivityCrudController') }}" class="btn btn-outline-success btn-sm">
                    <i class="fas fa-gamepad me-1"></i>Gerer les activites
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
