<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Les Eternels - Association de Jeux{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        :root {
            --primary-color: #1a1a2e;
            --secondary-color: #16213e;
            --accent-color: #e94560;
            --accent-hover: #c73652;
            --text-light: #f0f0f0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--accent-color) !important;
        }

        .navbar-custom {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            box-shadow: 0 2px 15px rgba(0,0,0,0.3);
        }

        .navbar-custom .nav-link {
            color: rgba(255,255,255,0.85) !important;
            transition: color 0.2s;
        }

        .navbar-custom .nav-link:hover {
            color: var(--accent-color) !important;
        }

        .btn-accent {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: white;
        }

        .btn-accent:hover {
            background-color: var(--accent-hover);
            border-color: var(--accent-hover);
            color: white;
        }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
            transition: all 0.3s ease;
        }

        .flash-messages {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 1060;
            min-width: 300px;
        }

        footer {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: rgba(255,255,255,0.8);
        }

        footer a { color: rgba(255,255,255,0.6); }
        footer a:hover { color: var(--accent-color); }

        .badge-status-active { background-color: #28a745; }
        .badge-status-expired { background-color: #ffc107; color: #333; }
        .badge-status-cancelled { background-color: #dc3545; }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <i class="fas fa-gamepad me-2"></i>Les Eternels
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">
                            <i class="fas fa-home me-1"></i>Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_activities') }}">
                            <i class="fas fa-gamepad me-1"></i>Activites
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_events') }}">
                            <i class="fas fa-calendar-alt me-1"></i>Evenements
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>
                                {{ app.user.firstName }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_member_dashboard') }}">
                                        <i class="fas fa-tachometer-alt me-2"></i>Mon Espace
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_member_profile') }}">
                                        <i class="fas fa-user-edit me-2"></i>Mon Profil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_member_my_events') }}">
                                        <i class="fas fa-calendar-check me-2"></i>Mes Evenements
                                    </a>
                                </li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="{{ path('admin') }}">
                                            <i class="fas fa-cog me-2"></i>Administration
                                        </a>
                                    </li>
                                {% endif %}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt me-2"></i>Deconnexion
                                    </a>
                                </li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">
                                <i class="fas fa-sign-in-alt me-1"></i>Connexion
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-accent btn-sm" href="{{ path('app_register') }}">
                                <i class="fas fa-user-plus me-1"></i>Inscription
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash Messages -->
    <div class="flash-messages">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow" role="alert">
                    <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'exclamation-circle' : 'info-circle') }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="text-white fw-bold">
                        <i class="fas fa-gamepad me-2" style="color: var(--accent-color);"></i>Les Eternels
                    </h5>
                    <p class="small">Association de jeux passionnee, reunissant joueurs d'airsoft, jeux de plateau, jeux video et bien plus encore.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="text-white fw-bold mb-3">Liens rapides</h6>
                    <ul class="list-unstyled">
                        <li><a href="{{ path('app_activities') }}" class="text-decoration-none small"><i class="fas fa-chevron-right me-1"></i>Nos activites</a></li>
                        <li><a href="{{ path('app_events') }}" class="text-decoration-none small"><i class="fas fa-chevron-right me-1"></i>Evenements</a></li>
                        <li><a href="{{ path('app_register') }}" class="text-decoration-none small"><i class="fas fa-chevron-right me-1"></i>Nous rejoindre</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="text-white fw-bold mb-3">Contact</h6>
                    <p class="small">
                        <i class="fas fa-envelope me-2"></i>contact@les-eternels.fr
                    </p>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.2);">
            <p class="text-center small mb-0">
                &copy; {{ "now"|date("Y") }} Les Eternels. Tous droits reserves.
            </p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}

    <script>
        // Auto-dismiss flash messages after 5 seconds
        document.querySelectorAll('.flash-messages .alert').forEach(function(alert) {
            setTimeout(function() {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }, 5000);
        });
    </script>
</body>
</html>
